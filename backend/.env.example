# Base de datos
DATABASE_URL="postgresql://movieswipe:movieswipe@localhost:5432/movieswipe?schema=public"

# Auth
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="30d"

# Servidor
PORT=3000
CORS_ORIGIN="*"

# Watchmode (SOLO el backend conoce esta clave, la app móvil nunca la ve)
WATCHMODE_API_KEY="tu-clave-de-watchmode"
WATCHMODE_BASE_URL="https://api.watchmode.com/v1"
CATALOG_SYNC_COUNTRY="ES"

# Cron de sincronización del catálogo (por defecto 03:00 todos los días)
CATALOG_SYNC_CRON="0 3 * * *"
